{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowJs": false,
    "isolatedModules": false,
    "noEmit": true,
    "lib": ["ES2020"],
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "src/**/*.ts",
    "index.ts",
    "tests/**/*.ts",
    "__tests__/**/*.ts",
    "__mocks__/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
